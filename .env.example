# Slack Incoming Webhook URL
# 未設定の場合、Slack投稿はスキップされ、warningログを出力します。
SLACK_WEBHOOK_URL=

# AI監査設定（Phase 2）
# AI監査を有効にする場合は true に設定（デフォルト: false）
AI_AUDIT_ENABLED=false
# LLMプロバイダー（claude | openai | gemini）
AI_AUDIT_PROVIDER=claude
# AI監査に使用するモデル
# Claude: claude-3-5-sonnet-latest / OpenAI: gpt-4o
AI_AUDIT_MODEL=claude-3-5-sonnet-latest
# AI提案を配分に反映するか（Phase 2では必ずfalse）
AI_AUDIT_APPLY_ADJUSTMENT=false

# Anthropic API Key（provider: claude の場合に必須）
ANTHROPIC_API_KEY=
# OpenAI API Key（provider: openai の場合に必須）
OPENAI_API_KEY=

# Slack インタラクション設定（Phase 3 / Phase 4.1）
# Slack App を使ってボタン押下受信（Socket Mode）を有効にする場合に設定
# 現在は Incoming Webhook（SLACK_WEBHOOK_URL）のみの利用でも動作します
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_INTERACTIVE_ENABLED=false
# ボタン押下を許可するSlackユーザーIDのカンマ区切りリスト（未設定なら制限なし）
SLACK_ALLOWED_USER_IDS=
